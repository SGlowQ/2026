<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WishWinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,12,28,0">

                <TextBlock
                    FontFamily="{StaticResource UiBlackFont}"
                    FontSize="28"
                    Text="关于" FontWeight="Black" />
                <TextBlock
                    FontFamily="{StaticResource UiLightFont}"
                    FontWeight="Light"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,2,0,16"
                    Text="祈愿与倒计时 · WinUI 3 版" />

                <!-- 程序信息 -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="56"
                            Height="56"
                            CornerRadius="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Image x:Name="AppLogo" Width="56" Height="56" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{StaticResource UiBlackFont}" FontSize="18" Text="祈愿与倒计时" FontWeight="Black" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="界面字体：鸿蒙 HarmonyOS Sans SC" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 数据位置 -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock FontFamily="{StaticResource UiBlackFont}" FontSize="16" Text="数据位置" FontWeight="Black" />
                        <TextBlock
                            Style="{StaticResource CaptionStyle}"
                            Text="名单、倒计时目标、抽卡历史与保底状态都只保存在这台电脑上，不会上传。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DataPathText"
                            Style="{StaticResource CaptionStyle}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <!-- 设置 -->
                <Border Style="{StaticResource SettingCardStyle}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="16,14,16,6">
                            <TextBlock FontFamily="{StaticResource UiBlackFont}" FontSize="16" Text="偏好设置" FontWeight="Black" />
                        </StackPanel>
                        <Grid Height="52" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="一言" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="关闭后不显示一言内容" />
                            </StackPanel>
                            <ToggleSwitch x:Name="QuoteSwitch" HorizontalAlignment="Right" Toggled="QuoteSwitch_Toggled" />
                        </Grid>
                        <Grid Height="52" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="网络时间" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="用北京时间校正软件倒计时" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TimeSwitch" HorizontalAlignment="Right" Toggled="TimeSwitch_Toggled" />
                        </Grid>
                        <Grid Height="52" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="主题" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="跟随系统 / 深色 / 浅色" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemeCombo"
                                HorizontalAlignment="Right"
                                MinWidth="130"
                                SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="深色" />
                                <ComboBoxItem Content="浅色" />
                            </ComboBox>
                        </Grid>
                        <Grid Height="52" Padding="16,0">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="数据保存位置" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <HyperlinkButton
                                    x:Name="RestoreFolderButton"
                                    Click="RestoreDataFolder_Click"
                                    ToolTipService.ToolTip="把数据搬回默认目录"
                                    Content="恢复默认位置"
                                    Visibility="Collapsed" />
                                <HyperlinkButton Click="ChangeDataFolder_Click" Content="更改位置" />
                                <HyperlinkButton Click="OpenDataFolder_Click" Content="打开文件夹" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 备份与恢复 -->
                <Border Style="{StaticResource SettingCardStyle}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="16,14,16,6">
                            <TextBlock FontFamily="{StaticResource UiBlackFont}" FontSize="16" Text="备份与恢复" FontWeight="Black" />
                        </StackPanel>
                        <Grid Height="56" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="导出备份" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="把名单、记录、设置打包成一个文件" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="ExportBackup_Click"
                                Content="导出…" />
                        </Grid>
                        <Grid Height="56" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="导入备份" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="从备份文件恢复（会覆盖当前数据）" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="ImportBackup_Click"
                                Content="导入…" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 清除数据 -->
                <Border Style="{StaticResource SettingCardStyle}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="16,14,16,6">
                            <TextBlock FontFamily="{StaticResource UiBlackFont}" FontSize="16" Text="清除数据" FontWeight="Black" />
                        </StackPanel>
                        <Grid Height="56" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="抽卡记录" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Name="HistoryCountText"
                                    Text="加载中…" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="ClearHistory_Click"
                                Content="清除" />
                        </Grid>
                        <Grid Height="56" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="名单" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Name="RosterCountText"
                                    Text="加载中…" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="ClearRoster_Click"
                                Content="清除" />
                        </Grid>
                        <Grid Height="56" Padding="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="倒计时目标" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    x:Name="TargetCountText"
                                    Text="加载中…" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="ClearTargets_Click"
                                Content="清除" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 说明（默认收起，点击展开） -->
                <Border Style="{StaticResource SettingCardStyle}" Padding="0">
                    <StackPanel>
                        <Button
                            x:Name="HelpToggle"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,14"
                            Click="HelpToggle_Click">
                            <Grid>
                                <TextBlock
                                    FontFamily="{StaticResource UiBlackFont}"
                                    FontSize="16"
                                    Text="说明" FontWeight="Black" />
                                <FontIcon
                                    x:Name="HelpChevron"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Glyph="&#xE70D;"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>

                        <StackPanel
                            x:Name="HelpPanel"
                            Padding="16,0,16,16"
                            Spacing="10"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【倒计时】默认自动跟随下一个春节（带干支年份名）。点击目标下拉框可以切换或新建自定义目标（自己起名字、定日期时间），随时切换；自定义目标可删除，春节目标会随年份自动更新。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【一言】每分钟从 hitokoto.cn 获取一句语录，带打字机特效和流动的彩虹渐变。切换到其他页面时暂停计时，切回来显示刚才那句并重新计时一分钟。拿不到内容时会显示「连接一言服务器失败」。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【网络时间】启动时校准一次软件倒计时偏差，全部按北京时间（UTC+8）计算。优先使用毫秒级高精度授时接口，失败时自动回退到公开网站的时间头，全部失败则使用本机时间。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【名单】粘贴或导入 TXT（一行一个名字，至少 10 个），应用后自动划分为五星 / 四星 / 三星角色池并随机选本期 UP。支持多个分组（如「1班」「2班」）随时切换；「整理」去重去空行，「排序」按名字排序，可导出 TXT 备份。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【历史记录】按周保存每一次抽卡结果，永久保留不会自动删除。顶部下拉框可以切换查看任意一周，每 5 条一页。点中间的页码按钮会弹出数字键盘，可以直接输入页码跳转（适配教室触屏黑板）。可导出本周或全部历史（Excel / CSV / TXT）。想清空时到「关于」页「清除数据」里操作。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【数据位置】所有数据保存在本机，不上传任何服务器。默认在 %AppData%\WishLamp\WishCountdown，可在上面「数据保存位置」里改到别处（现有数据会一起复制过去），改过之后会出现「恢复默认位置」按钮，一键搬回来。名单、倒计时目标、开关状态在 settings.json；抽卡历史与保底状态在 history.json。每周一 00:00 自动开始新的一周。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【统计】「统计」页基于全部历史计算真实出货率、平均保底抽数、UP 命中率、捕获明光次数，并和理论概率对比。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【外观】「关于」页可切换主题（跟随系统 / 深色 / 浅色）。界面统一使用鸿蒙字体 HarmonyOS Sans SC（细体 / 常规 / 黑体三个字重，随程序打包，无需联网或额外安装），元素图标使用系统 Emoji。" />
                            <TextBlock
                                Style="{StaticResource BodyStyle}"
                                TextWrapping="Wrap"
                                Text="【快捷键】Ctrl+1~6 切换页面，Ctrl+Enter 抽一次，Ctrl+Shift+Enter 十连。更详细的抽卡规则请到「祈愿」页点「规则说明」查看。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
