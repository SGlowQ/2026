<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WishWinUI.Views.WishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,12,28,0" Spacing="0">

                <!-- 标题 -->
                <TextBlock
                    FontFamily="{StaticResource UiBlackFont}"
                    FontSize="28"
                    Text="祈愿" FontWeight="Black" />
                <TextBlock
                    FontFamily="{StaticResource UiLightFont}"
                    FontWeight="Light"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,2,0,16"
                    TextWrapping="Wrap"
                    Text="点「祈愿」抽一次，点「十连」连抽十次；结果显示在按钮右侧。抽卡记录在「历史记录」页查看与导出。" />

                <!-- 本期 UP -->
                <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock
                                FontFamily="{StaticResource UiBlackFont}"
                                FontSize="16"
                                Text="本期 UP" FontWeight="Black" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                Padding="0"
                                Click="WhoIsUp_Click"
                                Content="查看角色池" />
                        </Grid>
                        <Grid x:Name="UpFiveRow" Grid.Row="1" ColumnSpacing="6" RowSpacing="4" />
                        <Grid x:Name="UpFourRow" Grid.Row="2" ColumnSpacing="6" RowSpacing="4" />
                    </Grid>
                </Border>

                <!-- 祈愿按钮区 -->
                <Border
                    Style="{StaticResource SettingCardStyle}"
                    Margin="0,0,0,12"
                    Padding="20,22">
                    <StackPanel Spacing="14">
                        <!-- 按钮行：窗口太窄时横向滚动，不会丢按钮 -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OpenHelp_Click" Content="规则说明" />
                                <Button Click="TenPullButton_Click" Content="十连" />
                            </StackPanel>
                        </ScrollViewer>
                        <!-- 祈愿按钮 + 右侧结果卡片（窄窗口下由代码改成上下排列） -->
                        <Grid x:Name="LotteryRow" ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button
                                x:Name="LotteryButton"
                                Grid.Column="0"
                                MinWidth="140"
                                Width="200"
                                Height="86"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="LotteryButton_Click">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontFamily="{StaticResource UiBlackFont}"
                                        FontSize="26"
                                        FontWeight="Black"
                                        HorizontalAlignment="Center"
                                        Text="祈愿" />
                                    <TextBlock
                                        x:Name="LotterySubText"
                                        FontSize="13"
                                        HorizontalAlignment="Center"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        Text="（累计 0 次）" />
                                </StackPanel>
                            </Button>

                            <!-- 抽卡结果：就在按钮右边显示，不再全屏弹卡片 -->
                            <Border
                                x:Name="ResultCard"
                                Grid.Column="1"
                                MinHeight="86"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,8"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <Border
                                            x:Name="ResultCaptureBadge"
                                            HorizontalAlignment="Left"
                                            Padding="8,1"
                                            Background="#33FFD700"
                                            BorderBrush="#FFD700"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Visibility="Collapsed">
                                            <TextBlock FontSize="11" FontWeight="Black" Foreground="#FFD700" Text="捕获明光" />
                                        </Border>
                                        <Grid x:Name="ResultNamePanel" ColumnSpacing="6" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ResultContinueButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        MinWidth="0"
                                        Padding="10,4"
                                        Click="ResultContinueButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="继续" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 保底进度：五星 / 四星各一条 -->
                        <Grid ColumnSpacing="10" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Foreground="#E8B923" Text="五星" FontFamily="{StaticResource UiLightFont}" FontWeight="Light" />
                            <ProgressBar x:Name="FiveStarProgress" Grid.Row="0" Grid.Column="1" Maximum="90" Height="4" VerticalAlignment="Center" Foreground="#E8B923" />
                            <TextBlock x:Name="FivePityText" Grid.Row="0" Grid.Column="2" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 / 90" FontFamily="{StaticResource UiLightFont}" FontWeight="Light" />

                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Foreground="#9B6DE8" Text="四星" FontFamily="{StaticResource UiLightFont}" FontWeight="Light" />
                            <ProgressBar x:Name="FourStarProgress" Grid.Row="1" Grid.Column="1" Maximum="10" Height="4" VerticalAlignment="Center" Foreground="#9B6DE8" />
                            <TextBlock x:Name="FourPityText" Grid.Row="1" Grid.Column="2" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 / 10" FontFamily="{StaticResource UiLightFont}" FontWeight="Light" />

                            <TextBlock
                                x:Name="PitySummary"
                                Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Margin="0,6,0,0"
                                FontFamily="{StaticResource UiLightFont}"
                                FontWeight="Light"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="明光计数 1/3" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 最近中奖（最多 10 条，按宽度自动换行） -->
                <Border Style="{StaticResource SettingCardStyle}" Padding="16,14">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontFamily="{StaticResource UiBlackFont}"
                            FontSize="16"
                            Text="最近中奖" FontWeight="Black" />
                        <Grid
                            x:Name="LastWinnersPanel"
                            ColumnSpacing="8"
                            RowSpacing="8"
                            SizeChanged="LastWinnersPanel_SizeChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
