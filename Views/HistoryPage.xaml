<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WishWinUI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,12,28,0">

                <TextBlock
                    FontFamily="{StaticResource UiBlackFont}"
                    FontSize="28"
                    Text="历史记录" FontWeight="Black" />
                <TextBlock
                    x:Name="HeaderCaption"
                    FontFamily="{StaticResource UiLightFont}"
                    FontWeight="Light"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,2,0,12"
                    TextWrapping="Wrap"
                    Text="当周祈愿记录，每 5 条一页" />

                <!-- 周切换 -->
                <Grid Margin="0,0,0,14" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="PrevWeekButton"
                        Grid.Column="0"
                        Click="PrevWeek_Click"
                        ToolTipService.ToolTip="上一周">
                        <FontIcon FontSize="13" Glyph="&#xE76B;" />
                    </Button>

                    <ComboBox
                        x:Name="WeekPicker"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="WeekPicker_SelectionChanged"
                        ToolTipService.ToolTip="选择要查看的周" />

                    <Button
                        x:Name="NextWeekButton"
                        Grid.Column="2"
                        Click="NextWeek_Click"
                        ToolTipService.ToolTip="下一周">
                        <FontIcon FontSize="13" Glyph="&#xE76C;" />
                    </Button>

                    <Button
                        x:Name="ThisWeekButton"
                        Grid.Column="3"
                        Click="ThisWeek_Click"
                        Content="回到本周" />
                </Grid>

                <!-- 汇总卡片 -->
                <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="SummaryTotal" FontFamily="{StaticResource UiBlackFont}" FontSize="24" Text="0" FontWeight="Black" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="总记录" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="SummaryFive" FontFamily="{StaticResource UiBlackFont}" FontSize="24" Foreground="#E8B923" Text="0" FontWeight="Black" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="五星" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="SummaryFour" FontFamily="{StaticResource UiBlackFont}" FontSize="24" Foreground="#9B6DE8" Text="0" FontWeight="Black" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="四星" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Name="SummaryThree" FontFamily="{StaticResource UiBlackFont}" FontSize="24" Foreground="#3FA9F5" Text="0" FontWeight="Black" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="三星" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 记录列表 -->
                <Border Style="{StaticResource SettingCardStyle}" Padding="0">
                    <StackPanel>
                        <StackPanel x:Name="HistoryList" Padding="8,8,8,0" />
                        <TextBlock
                            x:Name="EmptyHint"
                            Margin="20,32,20,32"
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionStyle}"
                            Text="本周还没有祈愿记录"
                            Visibility="Collapsed" />

                        <!-- 分页 -->
                        <Grid Padding="16,10,16,14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="PrevButton" Click="Prev_Click" Content="上一页" />
                                <Button
                                    MinWidth="110"
                                    MinHeight="36"
                                    Padding="12,6"
                                    Click="PageText_Click"
                                    ToolTipService.ToolTip="点击输入页码">
                                    <TextBlock
                                        x:Name="PageText"
                                        Text="1 / 1" />
                                </Button>
                                <Button x:Name="NextButton" Click="Next_Click" Content="下一页" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button Click="ExportAll_Click" Content="导出全部" />
                                <Button Click="Export_Click" Style="{StaticResource AccentButtonStyle}" Content="导出本周" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
