<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WishWinUI.Views.CountdownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,12,28,24">

                <TextBlock
                    FontFamily="{StaticResource UiBlackFont}"
                    FontSize="28"
                    Text="倒计时" FontWeight="Black" />
                <StackPanel Margin="0,2,0,16" Spacing="6">
                    <!-- 目标名字 + 下拉切换（可以保存多个自定义目标） -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Name="TargetPicker"
                            MinWidth="300"
                            SelectionChanged="TargetPicker_SelectionChanged" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TargetCaption"
                        FontFamily="{StaticResource UiLightFont}"
                        FontWeight="Light"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="距目标日期还有" />
                </StackPanel>

                <!-- 主倒计时卡片 -->
                <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,12" Padding="24,20">
                    <StackPanel Spacing="16">
                        <!-- 第一行：天数 + 时间单位（天数固定上限，剩余空间给四个时间格均分） -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MaxWidth="720" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="DaysText"
                                    FontFamily="{StaticResource UiRegularFont}"
                                    FontSize="84"
                                    LineHeight="92"
                                    Text="0天"
                                    TextWrapping="NoWrap" />
                            </Viewbox>
                            <Grid x:Name="TimeBlocks" Grid.Column="1" VerticalAlignment="Center" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="HoursTile" Grid.Row="0" Grid.Column="0" Style="{StaticResource StatTileStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="HoursText" Style="{StaticResource CountdownNumberStyle}" Text="00" />
                                        <TextBlock x:Name="HoursCaption" Style="{StaticResource CaptionStyle}" Text="小时" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MinutesTile" Grid.Row="0" Grid.Column="1" Style="{StaticResource StatTileStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="MinutesText" Style="{StaticResource CountdownNumberStyle}" Text="00" />
                                        <TextBlock x:Name="MinutesCaption" Style="{StaticResource CaptionStyle}" Text="分钟" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SecondsTile" Grid.Row="1" Grid.Column="0" Style="{StaticResource StatTileStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="SecondsText" Style="{StaticResource CountdownNumberStyle}" Text="00" />
                                        <TextBlock x:Name="SecondsCaption" Style="{StaticResource CaptionStyle}" Text="秒" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MillisTile" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTileStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="MillisText" Style="{StaticResource CountdownMillisStyle}" Text="000" />
                                        <TextBlock x:Name="MillisCaption" Style="{StaticResource CaptionStyle}" Text="毫秒" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 操作行 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="YearProgressText"
                                Grid.Column="0"
                                Style="{StaticResource CaptionStyle}"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TimeSourceText"
                                    Style="{StaticResource CaptionStyle}"
                                    VerticalAlignment="Center"
                                    Text="使用本机时间" />
                                <Button Click="AddTarget_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        <TextBlock Text="新建目标" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteTargetButton" Click="DeleteTarget_Click" ToolTipService.ToolTip="删除当前目标">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock Text="删除" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- 一言 -->
                <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,12" Padding="20,16">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock
                                FontFamily="{StaticResource UiBlackFont}"
                                FontSize="16"
                                Text="一言"
                                VerticalAlignment="Center" FontWeight="Black" />
                            <Button
                                x:Name="CopyQuoteButton"
                                HorizontalAlignment="Right"
                                Padding="8,2"
                                Click="CopyQuote_Click"
                                ToolTipService.ToolTip="复制这句话">
                                <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Name="QuoteText"
                            FontFamily="{StaticResource QuoteFont}"
                            FontSize="22"
                            FontWeight="Black"
                            LineHeight="34"
                            TextWrapping="Wrap"
                            Text="正在加载……">
                            <TextBlock.Foreground>
                                <!-- 水平彩虹渐变，6 个色标，颜色从左往右流动 -->
                                <LinearGradientBrush x:Name="QuoteGradient" StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.GradientStops>
                                        <GradientStop x:Name="QuoteStop1" Offset="0.0" Color="#FF6B6B" />
                                        <GradientStop x:Name="QuoteStop2" Offset="0.2" Color="#FFA526" />
                                        <GradientStop x:Name="QuoteStop3" Offset="0.4" Color="#7CE84F" />
                                        <GradientStop x:Name="QuoteStop4" Offset="0.6" Color="#4FC3F7" />
                                        <GradientStop x:Name="QuoteStop5" Offset="0.8" Color="#9B6DE8" />
                                        <GradientStop x:Name="QuoteStop6" Offset="1.0" Color="#FF6BC1" />
                                    </LinearGradientBrush.GradientStops>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock
                            x:Name="QuoteFrom"
                            Style="{StaticResource CaptionStyle}"
                            Text="" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
