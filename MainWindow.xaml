<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WishWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WishWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="祈愿与倒计时"
    mc:Ignorable="d">

    <!-- Windows 11 云母材质：和「设置」一样的背景质感 -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 系统标题栏（可拖动、自带最小化/最大化/关闭） -->
        <TitleBar x:Name="AppTitleBar" Title="祈愿与倒计时">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- 左侧导航 + 内容 -->
        <NavigationView
            x:Name="Nav"
            KeyDown="Root_KeyDown"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="倒计时" Tag="countdown">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="祈愿" Tag="wish">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="历史记录" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="统计" Tag="stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="名单" Tag="roster">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- 抽卡特效：不再全屏，而是一个居中的小卡片 -->
        <!-- 提示条 -->
        <InfoBar
            x:Name="ToastBar"
            Grid.Row="1"
            Margin="28,0,28,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />
    </Grid>
</Window>
